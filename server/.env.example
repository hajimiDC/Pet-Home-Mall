# 宠物之家商城 · 后端环境变量（复制为 .env 后按需修改；本项目未引入 dotenv，请通过系统环境变量或启动脚本注入）

# 监听端口（默认 8080）
PET_PORT=8080

# 数据库文件路径（默认 server/data/pet_home_mall.db）
PET_DB_FILE=./data/pet_home_mall.db

# 日志级别：debug | info | warn | error；PET_LOG_SILENT=1 可完全静默（测试用）
PET_LOG_LEVEL=info

# JWT 签名密钥（生产必须替换为随机强密钥）
PET_JWT_SECRET=pet-home-mall-dev-secret-2026

# 令牌有效期（分钟）：会员默认 7 天、后台默认 8 小时；后台静置超时 30 分钟
PET_USER_TOKEN_TTL_MIN=10080
PET_ADMIN_TOKEN_TTL_MIN=480
PET_ADMIN_IDLE_MIN=30

# 敏感字段（收款账户）加密密钥
PET_ENC_KEY=pet-home-mall-enc-key-2026
